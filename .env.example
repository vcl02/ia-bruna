# NÃO coloque valores reais aqui. Estes nomes vão para os secrets do Supabase
# (supabase secrets set NOME=valor), nunca para o repositório.
WHATSAPP_VERIFY_TOKEN=     # texto aleatório que você inventa e repete no painel da Meta
META_APP_SECRET=           # App Secret do app na Meta (valida X-Hub-Signature-256)
WHATSAPP_TOKEN=            # token de acesso (de preferência de usuário do sistema)
WHATSAPP_PHONE_NUMBER_ID=  # ID do número (não é o telefone)
GRAPH_API_VERSION=         # ex.: v00.0 — usar a versão mostrada no painel da Meta
ANTHROPIC_API_KEY=
PAINEL_ORIGEM=             # origem do painel para CORS, ex.: https://painel.exemplo.com
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já existem nas Edge Functions hospedadas.
